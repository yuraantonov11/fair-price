{
  "name": "fair-price-extension",
  "private": true,
  "version": "2.5.0",
  "type": "module",
  "scripts": {
    "setup": "npm ci",
    "setup:dev": "npm run setup && npm run test:e2e:install",
    "dev": "wxt",
    "dev:edge": "wxt -b edge",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "typecheck": "tsc --noEmit",
    "check:logs": "node scripts/check-logs.mjs",
    "test": "vitest run",
    "test:extension": "node scripts/test-extension.mjs",
    "test:watch": "vitest",
    "test:e2e": "npm run build:e2e && playwright test",
    "test:e2e:smoke": "npm run build:e2e && playwright test tests/e2e/smoke.spec.ts",
    "test:e2e:smoke:ci": "playwright test tests/e2e/smoke.spec.ts",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install chromium",
    "crawl": "node scripts/crawl.mjs",
    "crawl:test": "node scripts/crawl.mjs --limit 20",
    "doctor": "node scripts/agent-doctor.mjs --mode core",
    "doctor:crawl": "node scripts/agent-doctor.mjs --mode crawl",
    "verify": "npm run ci:check && npm run build",
    "verify:full": "npm run ci:check && npm run ci:build",
    "verify:agent": "npm run doctor && npm run verify",
    "verify:agent:crawl": "npm run doctor:crawl && npm run crawl:test",
    "ci:check": "npm run typecheck && npm run test && npm run check:logs",
    "ci:build": "npm run build && npm run build:firefox && npm run zip && npm run zip:firefox",
    "postinstall": "wxt prepare",
    "doctor:offline": "node scripts/agent-doctor.mjs --mode core --offline",
    "doctor:schema": "node scripts/agent-doctor.mjs --mode core --schema",
    "build:e2e": "node scripts/build-e2e.mjs",
    "archive": "node scripts/archive.mjs auto",
    "archive:verify": "node scripts/archive.mjs verify",
    "archive:restore": "node scripts/archive.mjs restore",
    "archive:announce-release": "node scripts/archive.mjs announce-release",
    "archive:privacy": "node scripts/archive.mjs privacy"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.100.0",
    "i18next": "^26.0.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^17.0.4",
    "recharts": "^3.8.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.55.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/chrome": "^0.1.38",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.2.2",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "vitest": "^5.0.5",
    "wxt": "^0.21.4"
  },
  "engines": {
    "node": ">=24"
  }
}
