# Supabase configuration used by src/utils/supabaseClient.ts
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_LOG_LEVEL=info

# Optional V2.x personalized-pricing baseline endpoint.
# Expected response JSON: {"baselinePrice": 1999, "currency": "UAH"}
VITE_BASELINE_API_URL=

# Optional explicit URL for crawler script. If empty, crawler falls back to VITE_SUPABASE_URL.
SUPABASE_URL=

# Required for scripts/crawl.mjs and GitHub Actions crawl workflow.
# Never commit real key values.
SUPABASE_SERVICE_ROLE_KEY=

# Optional crawler tuning (defaults are in scripts/crawl.mjs)
CRAWL_CONCURRENCY=10
CRAWL_DELAY_MS=2000
CRAWL_OFFSET=0
CRAWL_LIMIT=

# Optional override for Firefox Developer Edition binary used by wxt dev:firefox
# Example (Windows): C:/Program Files/Firefox Developer Edition/firefox.exe
WXT_FIREFOX_BINARY=

# Optional page that opens automatically in dev browser profile
WXT_START_URL=https://dnipro-m.ua/tovar/akumulyatorna-lancyugova-pila-dms-201bc/


# Server-only Edge trigger secret; never expose through a VITE_ variable.
# Configure it in Supabase secrets and GitHub Actions secrets.
CRAWL_TRIGGER_SECRET=

# Server/owner only: private GitHub archive. Never use VITE_ prefixes.
PRICE_ARCHIVE_REPO=yuraantonov11/fair-price-archive
PRICE_ARCHIVE_TOKEN=
# Enable only after archive:restore verifies an actual archived month.
PRICE_ARCHIVE_PRUNE=false
